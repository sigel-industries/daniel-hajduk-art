---
/**
 * The full collection as a gallery grid, newest first.
 * Filters: all, each discipline that has works, and works available now.
 */
import WorkCard from './WorkCard.astro';
import { CATEGORIES, type CategoryId } from '../data/site';
import { url } from '../lib/url';
import type { Work } from '../lib/works';

interface Props { works: Work[]; all: Work[]; active?: CategoryId; title?: string; intro?: string }
const { works, all, active, title = 'Works', intro } = Astro.props;
const present = CATEGORIES.filter((c) => all.some((w) => w.data.category === c.id));
const anyAvailable = all.some((w) => w.data.availability === 'available');
---
<header class="page-head">
  <h1 class="page-title">{title}</h1>
  <p class="page-intro">{intro ?? `${works.length} works. Earlier work and pieces available now.`}</p>
  <nav class="filters" aria-label="Filter works">
    <a href={url('/works/')} aria-current={!active ? 'page' : undefined}>All</a>
    {present.map((c) => <a href={url(`/works/${c.id}/`)} aria-current={active === c.id ? 'page' : undefined}>{c.label}</a>)}
    {anyAvailable && <a href={url('/available/')}>Available</a>}
  </nav>
</header>

<section class="grid-wrap" aria-label="Works">
  <div class="grid">
    {works.map((w, i) => <WorkCard work={w} eager={i < 3} />)}
  </div>
</section>
