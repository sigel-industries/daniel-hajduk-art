---
import Exhibit from './Exhibit.astro';
import EmptyWall from './EmptyWall.astro';
import { CATEGORIES, roomNumber, type CategoryId } from '../data/site';
import { url } from '../lib/url';
import { t } from '../i18n/ui';
import type { Work } from '../lib/works';

interface Props { works: Work[]; title: string; intro?: string; active?: CategoryId }
const { works, title, intro, active } = Astro.props;
const scope = active ? CATEGORIES.filter((c) => c.id === active) : CATEGORIES;
const empty = scope.filter((c) => !works.some((w) => w.data.category === c.id)).map((c) => c.id);
---
<header class="page-head" data-spot>
  {active && <p class="page-room"><span class="numeral">{roomNumber(active)}</span>Room</p>}
  <h1 class="display" style={`--chars:${title.length}`}>{title}</h1>
  <div class="page-head-foot">
    {intro && <p>{intro}</p>}
    <nav aria-label="Rooms">
      <ul class="filters">
        <li><a href={url('/works/')} aria-current={!active ? 'page' : undefined}>{t('works.all')}</a></li>
        {CATEGORIES.map((c) => (
          <li><a href={url(`/works/${c.id}/`)} aria-current={active === c.id ? 'page' : undefined}><span class="numeral">{roomNumber(c.id)}</span>{c.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

{works.map((w, i) => <Exhibit work={w} flip={i % 2 === 1} />)}

{empty.length > 0 && (
  <EmptyWall ids={empty} title={active ? 'This room is being installed' : 'Rooms in preparation'} />
)}
