---
/**
 * Rooms whose works are not documented yet: empty lit frames hung on a
 * common eye line. Shows nothing that is not there.
 */
import { CATEGORIES, roomNumber, type CategoryId } from '../data/site';
import { url } from '../lib/url';
import { t } from '../i18n/ui';

interface Props { ids: CategoryId[]; title?: string; headingLevel?: 'h2' | 'h3' }
const { ids, title = 'Rooms in preparation', headingLevel = 'h2' } = Astro.props;
const rooms = ids.map((id) => CATEGORIES.find((c) => c.id === id)!);
const H = headingLevel;
// Frame proportions per room, so the wall reads as a hang rather than a grid.
const SHAPE: Record<string, string> = { paintings: 'landscape', photography: 'portrait', other: 'square', sculptures: 'plinth' };
---
<section class="empty-wall" aria-labelledby="empty-wall-title">
  <div class="empty-head">
    <H id="empty-wall-title">{title}</H>
    <p>{t('works.empty')}</p>
  </div>
  <ul class:list={['hang', { single: rooms.length === 1 }]}>
    {rooms.map((c) => (
      <li>
        <a href={url(`/works/${c.id}/`)}>
          <span class:list={['frame-empty', SHAPE[c.id] ?? 'square']} aria-hidden="true"></span>
          <span class="hang-label"><span class="numeral">{roomNumber(c.id)}</span>{c.label}</span>
          <span class="hang-note">{c.intro}</span>
        </a>
      </li>
    ))}
  </ul>
</section>
