---
/**
 * The collection: calm centred rows of equal height, broken every few works by
 * a featured work hung alone and large. Nothing is cropped; works never touch.
 */
import { Picture } from 'astro:assets';
import type { Work } from '../lib/works';
import { curated } from '../lib/order';
import { FEATURED } from '../data/exhibition';
import { CATEGORIES, AVAILABILITY_LABEL } from '../data/site';
import { workUrl, formatPrice } from '../lib/url';

interface Props { works: Work[] }
const works = curated(Astro.props.works);
let f = 0;
const items = works.map((w) => ({ w, feature: FEATURED.includes(w.id), side: FEATURED.includes(w.id) ? (f++ % 2 ? 'right' : 'left') : '' }));
const meta = (w: Work) => {
  const d = w.data;
  return [CATEGORIES.find((c) => c.id === d.category)!.singular, d.year, d.dimensions].filter(Boolean).join(', ');
};
---
<ul class="collection">
  {items.map(({ w, feature, side }, i) => {
    const d = w.data;
    const r = d.cover.width / d.cover.height;
    const forSale = d.availability === 'available';
    const href = workUrl(d.category, w.id);
    return feature ? (
      <li class:list={['feature', side]} style={`--r:${r.toFixed(3)}`}>
        <a href={href} class="f-img" data-reveal>
          <Picture src={d.cover} alt={d.coverAlt} widths={[800, 1200, 1700, 2200]} sizes="(max-width: 48rem) 100vw, 70vw" formats={['avif', 'webp']} />
        </a>
        <div class="f-cap">
          <a href={href} class="f-title">{d.title}</a>
          <span class="c-meta">{meta(w)}</span>
        </div>
      </li>
    ) : (
      <li style={`--r:${r.toFixed(3)}`}>
        <a href={href}>
          <span class="c-img" data-reveal>
            <Picture src={d.cover} alt={d.coverAlt} widths={[400, 700, 1000, 1400]} sizes="(max-width: 48rem) 100vw, 30vw" formats={['avif', 'webp']} loading={i < 4 ? 'eager' : 'lazy'} />
          </span>
          <span class="c-cap">
            <span class="c-title">{d.title}</span>
            <span class="c-meta">{meta(w)}{forSale && <span class="c-sale"> · {AVAILABILITY_LABEL.available}{d.price ? `, ${formatPrice(d.price.amount, d.price.currency)}` : ''}</span>}</span>
          </span>
        </a>
      </li>
    );
  })}
</ul>
