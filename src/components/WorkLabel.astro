---
/**
 * Museum wall label: artist, title, medium, dimensions, edition, status, price.
 * Only fields present in the work's frontmatter are shown.
 */
import type { Work } from '../lib/works';
import { AVAILABILITY_LABEL, SITE } from '../data/site';
import { workUrl, formatPrice } from '../lib/url';

interface Props {
  work: Work;
  headingLevel?: 'h1' | 'h2' | 'h3';
  headingId?: string;
  /** link the title + show "View the work" (rooms) vs. purchase actions (detail page) */
  mode?: 'room' | 'detail';
}
const { work, headingLevel = 'h2', headingId, mode = 'room' } = Astro.props;
const d = work.data;
const href = workUrl(d.category, work.id);
const H = headingLevel;
const forSale = d.availability === 'available';
const medium = [d.technique, d.materials].filter(Boolean);
---
<div class="label">
  <p class="label-artist">{SITE.name}</p>
  <H class="label-title" id={headingId}>
    {mode === 'room' ? <a href={href}>{d.title}</a> : d.title}{d.year && <span class="label-year">, {d.year}</span>}
  </H>
  {medium.map((m) => <p class="label-line">{m}</p>)}
  {d.dimensions && <p class="label-line">{d.dimensions}</p>}
  {d.edition && <p class="label-line">Limited edition of {d.edition.size}, numbered and signed</p>}

  <dl class="label-status">
    <div>
      <dt>Status</dt>
      <dd><span class="status" data-state={d.availability}>{AVAILABILITY_LABEL[d.availability]}</span></dd>
    </div>
    {forSale && d.edition && d.edition.available.length > 0 && (
      <div><dt>Copies</dt><dd>{d.edition.available.join(', ')}</dd></div>
    )}
    {forSale && d.price && (
      <div><dt>Price</dt><dd>{formatPrice(d.price.amount, d.price.currency)}{d.price.note && <span class="label-note"> {d.price.note}</span>}</dd></div>
    )}
  </dl>

  {mode === 'room' ? (
    <a class="label-link" href={href}>View the work</a>
  ) : (
    <div class="label-actions">
      {d.links.map((l, i) => (
        <a class:list={['action', { quiet: i > 0 }]} href={l.url} rel="noopener" target="_blank">{l.label}<span class="visually-hidden"> (opens in a new tab)</span></a>
      ))}
      {SITE.email && <a class="action quiet" href={`mailto:${SITE.email}?subject=${encodeURIComponent(d.title)}`}>Enquire about this work</a>}
    </div>
  )}
</div>
