---
/**
 * A work emerging from the dark as the visitor scrolls into it.
 * The stage is sticky; scroll progress (--p) lifts the light on the work.
 * Works of any format: portrait sculpture, wide painting, photographic series.
 */
import { Picture } from 'astro:assets';
import type { Work } from '../lib/works';
import { workPalette } from '../lib/palette';
import { CATEGORIES } from '../data/site';
import { workUrl } from '../lib/url';

interface Props { work: Work; index?: number }
const { work, index = 0 } = Astro.props;
const d = work.data;
const href = workUrl(d.category, work.id);
const palette = await workPalette(work);
const kind = CATEGORIES.find((c) => c.id === d.category)!.singular;
const meta = [kind, d.materials ?? d.technique, d.year].filter(Boolean).join(', ');
const landscape = d.cover.width > d.cover.height;
---
<section
  class:list={['apparition', { landscape, alt: index % 2 === 1 }]}
  aria-labelledby={`app-${work.id}`}
  data-palette={JSON.stringify(palette)}
  data-progress
>
  <div class="apparition-stage">
    <a class="apparition-work" href={href} tabindex="-1" aria-hidden="true">
      <Picture src={d.cover} alt={d.coverAlt} widths={[640, 1000, 1500, 2000]} sizes={landscape ? '(max-width: 48rem) 100vw, 72vw' : '(max-width: 48rem) 86vw, 40vw'} formats={['avif', 'webp']} />
    </a>
    <h2 class="apparition-title" id={`app-${work.id}`}><a href={href}>{d.title}</a></h2>
    <div class="apparition-meta">
      <p>{meta}</p>
      {d.summary && <p class="apparition-summary">{d.summary}</p>}
      <a class="quiet-link" href={href}>Enter the work</a>
    </div>
  </div>
</section>
