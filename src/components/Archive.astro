---
/**
 * The archive: every work on identical mounts in a regular grid, or as a list.
 * Order is automatic (src/lib/curation.ts). Filters are generated from the data:
 * category, body of work, period (decade from `year`), availability, plus search.
 * Filters, search and view are independent and kept in the URL; both views show
 * exactly the same set of works. Without JavaScript everything is shown.
 */
import Mount from './Mount.astro';
import type { Work } from '../lib/works';
import { sequence } from '../lib/curation';
import { viewerAttrs } from '../lib/viewer';
import { getCategories, getGroups, categoryOf, groupOf, captionOf } from '../lib/taxonomy';
import { AVAILABILITY_LABEL } from '../data/site';
import { workUrl, formatPrice } from '../lib/url';

interface Props { works: Work[]; preset?: Record<string, string> }
const { preset = {} } = Astro.props;
const works = await sequence(Astro.props.works);
const decade = (y: unknown) => { const n = parseInt(String(y ?? ''), 10); return Number.isFinite(n) ? `${Math.floor(n / 10) * 10}s` : ''; };
const rows = await Promise.all(works.map(async (w) => ({ w, v: await viewerAttrs(w), cat: await categoryOf(w), grp: await groupOf(w), cap: await captionOf(w, false) })));

const tally = (vals: string[]) => vals.reduce((m, v) => (v ? m.set(v, (m.get(v) ?? 0) + 1) : m), new Map<string, number>());
const catN = tally(rows.map((r) => r.cat.id)), grpN = tally(rows.map((r) => r.grp?.id ?? '')), perN = tally(rows.map((r) => decade(r.w.data.year))), avN = tally(rows.map((r) => r.w.data.availability ?? ''));
const groups = [
  { key: 'c', label: 'Category', opts: (await getCategories()).filter((c) => catN.has(c.id)).map((c) => ({ v: c.id, label: c.label, n: catN.get(c.id)! })) },
  { key: 'g', label: 'Body of work', opts: (await getGroups()).filter((g) => grpN.has(g.id)).map((g) => ({ v: g.id, label: g.title, n: grpN.get(g.id)! })) },
  { key: 'p', label: 'Period', opts: [...perN].sort((a, b) => b[0].localeCompare(a[0])).map(([v, n]) => ({ v, label: v, n })) },
  { key: 's', label: 'Availability', opts: [...avN].map(([v, n]) => ({ v, label: AVAILABILITY_LABEL[v] ?? v, n })) },
].filter((g) => g.opts.length > 1 || (g.key === 's' && g.opts.length > 0));
---
<div class="archive" data-archive data-preset={JSON.stringify(preset)}>
  <div class="archive-tools">
    <div class="filter-groups">
      {groups.map((g) => (
        <div class="filter-group" role="group" aria-label={g.label}>
          <span class="filter-label">{g.label}</span>
          {g.opts.map((o) => <button type="button" class="chip" data-key={g.key} data-value={o.v} aria-pressed="false">{o.label}<span class="chip-n">{o.n}</span></button>)}
        </div>
      ))}
    </div>
    <div class="archive-bar">
      <label class="search"><span class="visually-hidden">Search works</span><input type="search" placeholder="Search title, technique…" data-search /></label>
      <p class="result-count" aria-live="polite" data-count>{works.length} works</p>
      <div class="view-toggle" role="group" aria-label="View">
        <button type="button" data-view="grid" aria-pressed="true">Grid</button>
        <button type="button" data-view="list" aria-pressed="false">List</button>
      </div>
    </div>
  </div>

  <ul class="hang hang-m" data-items>
    {rows.map(({ w, v, cat, grp, cap }, i) => {
      const d = w.data;
      const text = [d.title, d.technique, d.materials, d.series, cat.label, grp?.title].filter(Boolean).join(' ').toLowerCase();
      const status = d.availability === 'available' ? `${AVAILABILITY_LABEL.available}${d.price ? `, ${formatPrice(d.price.amount, d.price.currency)}` : ''}` : d.availability ? AVAILABILITY_LABEL[d.availability] : '';
      return (
        <li class="plate" style={`--r:${(d.cover.width / d.cover.height).toFixed(4)}`} data-c={cat.id} data-g={grp?.id ?? ''} data-p={decade(d.year)} data-s={d.availability ?? ''} data-text={text}>
          <a href={workUrl(d.category, w.id)} {...v}>
            <Mount src={d.cover} alt={d.coverAlt} sizes="(max-width: 40rem) 46vw, (max-width: 70rem) 30vw, 22vw" eager={i < 8} />
            <span class="plate-cap">
              <span class="plate-title">{d.title}</span>
              <span class="plate-meta">{cap}</span>
              <span class="plate-extra">{[d.technique ?? d.materials, grp?.title].filter(Boolean).join(' · ')}</span>
              {status && <span class:list={['plate-status', { sale: d.availability === 'available' }]}>{status}</span>}
            </span>
          </a>
        </li>
      );
    })}
  </ul>
  <p class="archive-empty" data-empty hidden>No works match this selection. <button type="button" data-reset>Show all works</button></p>
</div>

<script>
  function initArchive() {
    const root = document.querySelector<HTMLElement>('[data-archive]');
    if (!root) return;
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-items] > li'));
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('.chip'));
    const search = root.querySelector<HTMLInputElement>('[data-search]')!;
    const countEl = root.querySelector<HTMLElement>('[data-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const views = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-view]'));
    const keys = ['c', 'g', 'p', 's'];
    const state: Record<string, Set<string>> = Object.fromEntries(keys.map((k) => [k, new Set<string>()]));
    const params = new URLSearchParams(location.search);
    const preset = JSON.parse(root.dataset.preset || '{}');
    for (const k of keys) (params.get(k) ?? preset[k] ?? '').split(',').filter(Boolean).forEach((v: string) => state[k].add(v));
    let q = (params.get('q') ?? '').toLowerCase();
    search.value = q;
    let stored = '';
    try { stored = localStorage.getItem('archive-view') || ''; } catch {}
    let view = (params.get('view') || stored) === 'list' ? 'list' : 'grid';

    const apply = (push = true) => {
      let n = 0;
      for (const it of items) {
        const ok = keys.every((k) => !state[k].size || state[k].has(it.dataset[k] || '')) && (!q || (it.dataset.text || '').includes(q));
        it.hidden = !ok;
        if (ok) n++;
      }
      chips.forEach((c) => c.setAttribute('aria-pressed', String(state[c.dataset.key!].has(c.dataset.value!))));
      countEl.textContent = n === items.length ? `${n} works` : `${n} of ${items.length} works`;
      empty.hidden = n > 0;
      root.classList.toggle('is-list', view === 'list');
      views.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === view)));
      if (push) {
        const p = new URLSearchParams();
        for (const k of keys) if (state[k].size) p.set(k, [...state[k]].join(','));
        if (q) p.set('q', q);
        if (view === 'list') p.set('view', 'list');
        history.replaceState(history.state, '', `${location.pathname}${p.toString() ? '?' + p : ''}`);
      }
    };
    chips.forEach((c) => c.addEventListener('click', () => {
      const set = state[c.dataset.key!];
      set.has(c.dataset.value!) ? set.delete(c.dataset.value!) : set.add(c.dataset.value!);
      apply();
    }));
    search.addEventListener('input', () => { q = search.value.trim().toLowerCase(); apply(); });
    views.forEach((b) => b.addEventListener('click', () => { view = b.dataset.view!; try { localStorage.setItem('archive-view', view); } catch {} apply(); }));
    root.querySelector('[data-reset]')!.addEventListener('click', () => { keys.forEach((k) => state[k].clear()); q = ''; search.value = ''; apply(); });
    apply(false);
  }
  document.addEventListener('astro:page-load', initArchive);
</script>
