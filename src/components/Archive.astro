---
/**
 * The archive: every work, in a calm automatic sequence.
 * - Grid: centred rows of equal height (proportions kept, nothing cropped);
 *   works marked `featured` get a wall to themselves.
 * - List: compact rows with thumbnail and facts, for finding a work quickly.
 * - Filters appear only for data that exists: discipline, period (decade, from
 *   `year`), series, availability, plus a search. The state is kept in the URL,
 *   so a filtered view can be shared or returned to.
 * Works without JavaScript: everything is simply shown.
 */
import { Picture } from 'astro:assets';
import type { Work } from '../lib/works';
import { sequence, profile } from '../lib/curation';
import { CATEGORIES, AVAILABILITY_LABEL } from '../data/site';
import { workUrl, formatPrice } from '../lib/url';

interface Props { works: Work[]; preset?: { d?: string; s?: string } }
const { preset = {} } = Astro.props;
const works = await sequence(Astro.props.works);
const rows = await Promise.all(works.map(async (w) => ({ w, p: await profile(w) })));

const decade = (y: unknown) => { const n = parseInt(String(y ?? ''), 10); return Number.isFinite(n) ? `${Math.floor(n / 10) * 10}s` : ''; };
const count = <T,>(vals: T[]) => vals.reduce((m, v) => m.set(v, (m.get(v) ?? 0) + 1), new Map<T, number>());

const disciplines = CATEGORIES.map((c) => ({ id: c.id, label: c.label, n: works.filter((w) => w.data.category === c.id).length })).filter((c) => c.n);
const periods = [...count(works.map((w) => decade(w.data.year)).filter(Boolean))].sort((a, b) => b[0].localeCompare(a[0]));
const series = [...count(works.map((w) => w.data.series).filter(Boolean) as string[])].sort();
const statuses = [...count(works.map((w) => w.data.availability).filter(Boolean) as string[])];
const groups = [
  { key: 'd', label: 'Discipline', opts: disciplines.map((c) => ({ v: c.id, label: c.label, n: c.n })) },
  { key: 'p', label: 'Period', opts: periods.map(([v, n]) => ({ v, label: v, n })) },
  { key: 'r', label: 'Series', opts: series.map(([v, n]) => ({ v, label: v, n })) },
  { key: 's', label: 'Availability', opts: statuses.map(([v, n]) => ({ v, label: AVAILABILITY_LABEL[v], n })) },
].filter((g) => g.opts.length > (g.key === 'd' ? 1 : 0));
const meta = (w: Work) => [CATEGORIES.find((c) => c.id === w.data.category)!.singular, w.data.year, w.data.dimensions].filter(Boolean).join(', ');
---
<div class="archive" data-archive data-preset={JSON.stringify(preset)}>
  <div class="archive-tools">
    <div class="filter-groups">
      {groups.map((g) => (
        <div class="filter-group" role="group" aria-label={g.label}>
          <span class="filter-label">{g.label}</span>
          {g.opts.map((o) => <button type="button" class="chip" data-key={g.key} data-value={o.v} aria-pressed="false">{o.label}<span class="chip-n">{o.n}</span></button>)}
        </div>
      ))}
    </div>
    <div class="archive-bar">
      <label class="search"><span class="visually-hidden">Search works</span><input type="search" placeholder="Search" data-search /></label>
      <p class="result-count" aria-live="polite" data-count>{works.length} works</p>
      <div class="view-toggle" role="group" aria-label="View">
        <button type="button" data-view="grid" aria-pressed="true">Grid</button>
        <button type="button" data-view="list" aria-pressed="false">List</button>
      </div>
    </div>
  </div>

  <ul class="collection" data-items>
    {rows.map(({ w, p }, i) => {
      const d = w.data;
      const r = d.cover.width / d.cover.height;
      const forSale = d.availability === 'available';
      const text = [d.title, d.technique, d.materials, d.series, CATEGORIES.find((c) => c.id === d.category)!.label].filter(Boolean).join(' ').toLowerCase();
      return (
        <li
          class:list={{ feature: d.featured }}
          style={`--r:${r.toFixed(3)};--tone:${p.tone}`}
          data-d={d.category} data-p={decade(d.year)} data-r={d.series ?? ''} data-s={d.availability ?? ''} data-text={text}
        >
          <a href={workUrl(d.category, w.id)}>
            <span class="c-img">
              <Picture src={d.cover} alt={d.coverAlt} widths={[400, 700, 1000, 1500, 2000]} sizes={d.featured ? '(max-width: 48rem) 100vw, 70vw' : '(max-width: 48rem) 100vw, 30vw'} formats={['avif', 'webp']} loading={i < 6 ? 'eager' : 'lazy'} decoding="async" />
            </span>
            <span class="c-cap">
              <span class="c-title">{d.title}</span>
              <span class="c-meta">{meta(w)}</span>
              <span class="c-list-extra">{[d.technique, d.series].filter(Boolean).join(', ')}</span>
              <span class="c-status">{forSale ? <span class="c-sale">{AVAILABILITY_LABEL.available}{d.price ? `, ${formatPrice(d.price.amount, d.price.currency)}` : ''}</span> : d.availability ? AVAILABILITY_LABEL[d.availability] : ''}</span>
            </span>
          </a>
        </li>
      );
    })}
  </ul>
  <p class="archive-empty" data-empty hidden>No works match this selection. <button type="button" data-reset>Show all works</button></p>
</div>

<script>
  function initArchive() {
    const root = document.querySelector<HTMLElement>('[data-archive]');
    if (!root) return;
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-items] > li'));
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('.chip'));
    const search = root.querySelector<HTMLInputElement>('[data-search]')!;
    const countEl = root.querySelector<HTMLElement>('[data-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const list = root.querySelector<HTMLElement>('[data-items]')!;
    const views = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-view]'));
    const state: Record<string, Set<string>> = { d: new Set(), p: new Set(), r: new Set(), s: new Set() };
    let q = '';

    const params = new URLSearchParams(location.search);
    const preset = JSON.parse(root.dataset.preset || '{}');
    for (const k of Object.keys(state)) (params.get(k) ?? preset[k] ?? '').split(',').filter(Boolean).forEach((v: string) => state[k].add(v));
    q = params.get('q') ?? '';
    search.value = q;
    let view = params.get('view') === 'list' || localStorage.getItem('archive-view') === 'list' ? 'list' : 'grid';

    const apply = (push = true) => {
      let n = 0;
      for (const it of items) {
        const ok = Object.entries(state).every(([k, set]) => !set.size || set.has(it.dataset[k] || '')) && (!q || (it.dataset.text || '').includes(q));
        it.hidden = !ok;
        if (ok) n++;
      }
      chips.forEach((c) => c.setAttribute('aria-pressed', String(state[c.dataset.key!].has(c.dataset.value!))));
      countEl.textContent = n === items.length ? `${n} works` : `${n} of ${items.length} works`;
      empty.hidden = n > 0;
      list.dataset.view = view;
      root.classList.toggle('is-list', view === 'list');
      views.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === view)));
      if (push) {
        const p = new URLSearchParams();
        for (const [k, set] of Object.entries(state)) if (set.size) p.set(k, [...set].join(','));
        if (q) p.set('q', q);
        if (view === 'list') p.set('view', 'list');
        history.replaceState(history.state, '', `${location.pathname}${p.toString() ? '?' + p : ''}`);
      }
    };
    chips.forEach((c) => c.addEventListener('click', () => {
      const set = state[c.dataset.key!];
      set.has(c.dataset.value!) ? set.delete(c.dataset.value!) : set.add(c.dataset.value!);
      apply();
    }));
    search.addEventListener('input', () => { q = search.value.trim().toLowerCase(); apply(); });
    views.forEach((b) => b.addEventListener('click', () => { view = b.dataset.view!; try { localStorage.setItem('archive-view', view); } catch {} apply(); }));
    root.querySelector('[data-reset]')!.addEventListener('click', () => { Object.values(state).forEach((s) => s.clear()); q = ''; search.value = ''; apply(); });
    apply(false);
  }
  document.addEventListener('astro:page-load', initArchive);
</script>
