---
/**
 * Home page: one room per body of work (see getRooms in lib/taxonomy.ts).
 * Each shows its selected works first, up to four, hung on one line at a
 * shared height, and leads to the room's own page. New groups and works
 * appear automatically.
 */
import { fieldRatio } from '../lib/field';
import Mount from './Mount.astro';
import type { Work } from '../lib/works';
import { sequence } from '../lib/curation';
import { viewerAttrs } from '../lib/viewer';
import { getRooms, yearSpan, captionOf } from '../lib/taxonomy';
import { workUrl, url } from '../lib/url';

interface Props { works: Work[]; exclude?: string }
const { works, exclude } = Astro.props;
const sections = [];
for (const room of await getRooms(works)) {
  const pool = room.works.filter((w) => w.id !== exclude);
  const picked = pool.filter((w) => w.data.selected);
  const shown: Work[] = (await sequence([...picked, ...pool.filter((w) => !picked.includes(w))])).slice(0, 4);
  if (!shown.length) continue;
  const items = await Promise.all(shown.map(async (w) => ({ w, v: await viewerAttrs(w), cap: await captionOf(w, false) })));
  sections.push({ room, span: yearSpan(room.works), items });
}
---
{sections.map(({ room, span, items }) => (
  <section class="room" aria-labelledby={`room-${room.id}`}>
    <header class="room-head">
      <p class="room-no" aria-hidden="true">{room.no}</p>
      <h2 id={`room-${room.id}`}>{room.title}</h2>
      <p class="room-facts">{room.works.length === 1 ? '1 work' : `${room.works.length} works`}{span && `, ${span}`}</p>
      {room.intro && <p class="room-intro">{room.intro}</p>}
      <a class="room-link" href={url(`/rooms/${room.id}/`)}>Enter room</a>
    </header>
    <ul class="hang hang-l hang-line">
      {items.map(({ w, v, cap }) => (
        <li class="plate" style={`--r:${fieldRatio(w.data.cover)}`}>
          <a href={workUrl(w.data.category, w.id)} {...v}>
            <Mount src={w.data.cover} alt={w.data.coverAlt} sizes="(max-width: 40rem) 50vw, 30vw" />
            <span class="plate-cap"><span class="plate-title">{w.data.title}</span><span class="plate-meta">{cap}</span></span>
          </a>
        </li>
      ))}
    </ul>
  </section>
))}
