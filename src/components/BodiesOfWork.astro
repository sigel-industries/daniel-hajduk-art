---
import { fieldRatio } from '../lib/field';
/**
 * Home page presentation: one section per body of work (src/content/groups/),
 * in their order. Each section shows the works marked `selected` (or, if none,
 * the first works of the group): up to four, hung on one line at the home page
 * scale (see .hang-line in global.css). Works without a group are
 * gathered under "Other works". New groups and works appear automatically.
 */
import Mount from './Mount.astro';
import type { Work } from '../lib/works';
import { sequence } from '../lib/curation';
import { viewerAttrs } from '../lib/viewer';
import { getGroups, captionOf } from '../lib/taxonomy';
import { workUrl, url } from '../lib/url';

interface Props { works: Work[]; exclude?: string }
const { works, exclude } = Astro.props;
const groups = await getGroups();
const sections = [];
for (const g of [...groups, { id: '', title: 'Other works', order: 999 }]) {
  const all = works.filter((w) => (w.data.group ?? '') === g.id);
  if (!all.length) continue;
  const pool = all.filter((w) => w.id !== exclude);
  const picked = pool.filter((w) => w.data.selected);
  const src = [...picked, ...pool.filter((w) => !picked.includes(w))];
  // up to four works on one line; the line scales down to fit, keeping one height
  const shown: Work[] = (await sequence(src)).slice(0, 4);
  if (!shown.length) continue;

  const items = await Promise.all(shown.map(async (w) => ({ w, v: await viewerAttrs(w), cap: await captionOf(w, false) })));
  sections.push({ g, total: all.length, items });
}
---
{sections.map(({ g, total, items }, si) => (
  <section class="body" aria-labelledby={`body-${si}`}>
    <header class="body-head">
      <h2 id={`body-${si}`}>{g.title}</h2>
      {'intro' in g && g.intro && <p class="body-intro">{g.intro}</p>}
      <a class="quiet-link" href={g.id ? url(`/works/?g=${g.id}`) : url('/works/')}>{total === 1 ? '1 work' : `All ${total} works`}</a>
    </header>
    <ul class="hang hang-l hang-line">
      {items.map(({ w, v, cap }, i) => (
        <li class="plate" style={`--r:${fieldRatio(w.data.cover)}`}>
          <a href={workUrl(w.data.category, w.id)} {...v}>
            <Mount src={w.data.cover} alt={w.data.coverAlt} sizes="(max-width: 40rem) 100vw, 50vw" eager={si === 0} />
            <span class="plate-cap"><span class="plate-title">{w.data.title}</span><span class="plate-meta">{cap}</span></span>
          </a>
        </li>
      ))}
    </ul>
  </section>
))}
