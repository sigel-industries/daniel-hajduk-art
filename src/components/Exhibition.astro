---
/**
 * Shows works as a curated sequence of moments (see src/data/exhibition.ts).
 * Given a subset (e.g. a discipline filter), the hang keeps its order; a pair
 * that loses one work becomes a solo.
 */
import { Picture } from 'astro:assets';
import type { Work } from '../lib/works';
import { HANG, type Moment } from '../data/exhibition';
import { CATEGORIES, AVAILABILITY_LABEL } from '../data/site';
import { workUrl, formatPrice } from '../lib/url';

interface Props { works: Work[] }
const { works } = Astro.props;
const byId = new Map(works.map((w) => [w.id, w]));

type Resolved = { kind: 'solo'; size: string; align: string; works: Work[] } | { kind: 'pair'; offset: boolean; works: Work[] };
const used = new Set<string>();
const moments: Resolved[] = [];
for (const m of HANG as Moment[]) {
  const ws = m.works.map((id) => byId.get(id)).filter(Boolean) as Work[];
  ws.forEach((w) => used.add(w.id));
  if (ws.length === 2 && m.kind === 'pair') moments.push({ kind: 'pair', offset: !!m.offset, works: ws });
  else if (ws.length >= 1) moments.push({ kind: 'solo', size: m.kind === 'solo' ? m.size ?? 'l' : 'm', align: m.kind === 'solo' ? m.align ?? 'center' : 'center', works: [ws[0]] });
}
// works not yet placed by hand: wide ones alone, upright ones in pairs
const rest = works.filter((w) => !used.has(w.id));
const aligns = ['start', 'end', 'center'];
let waiting: Work | null = null;
rest.forEach((w, i) => {
  const wide = w.data.cover.width > w.data.cover.height * 1.1;
  if (wide) moments.push({ kind: 'solo', size: 'l', align: aligns[i % 3], works: [w] });
  else if (waiting) { moments.push({ kind: 'pair', offset: i % 2 === 0, works: [waiting, w] }); waiting = null; }
  else waiting = w;
});
if (waiting) moments.push({ kind: 'solo', size: 'm', align: 'center', works: [waiting] });

const caption = (w: Work) => {
  const d = w.data;
  const cat = CATEGORIES.find((c) => c.id === d.category)!;
  return { meta: [cat.singular, d.year, d.dimensions].filter(Boolean).join(', '), sale: d.availability === 'available' ? `${AVAILABILITY_LABEL.available}${d.price ? `, ${formatPrice(d.price.amount, d.price.currency)}` : ''}` : d.availability ? AVAILABILITY_LABEL[d.availability] : '' };
};
---
<div class="hang">
  {moments.map((m, mi) => (
    <section
      class:list={['moment', m.kind, m.kind === 'solo' ? [`size-${m.size}`, `align-${m.align}`] : { offset: m.offset }]}
      aria-label={m.works.map((w) => w.data.title).join(' and ')}
    >
      {m.works.map((w) => {
        const c = caption(w);
        const wide = w.data.cover.width > w.data.cover.height * 1.1;
        return (
          <figure class:list={['piece', { wide }]}>
            <a href={workUrl(w.data.category, w.id)} class="piece-img" data-reveal>
              <Picture src={w.data.cover} alt={w.data.coverAlt} widths={[600, 1000, 1500, 2000]} sizes={m.kind === 'solo' ? '(max-width: 48rem) 92vw, 80vw' : '(max-width: 48rem) 80vw, 42vw'} formats={['avif', 'webp']} loading={mi < 1 ? 'eager' : 'lazy'} />
            </a>
            <figcaption>
              <a href={workUrl(w.data.category, w.id)}>{w.data.title}</a>
              <span>{c.meta}</span>
              {c.sale && <span class:list={{ sale: w.data.availability === 'available' }}>{c.sale}</span>}
            </figcaption>
          </figure>
        );
      })}
    </section>
  ))}
</div>
