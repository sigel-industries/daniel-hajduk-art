---
/**
 * How a work is shown anywhere on the site: whole (object-fit: contain) inside
 * a quiet exhibition field: a slightly darker neutral ground, a hairline and a
 * soft contact shadow. The field's proportions come from fieldRatio(), so it
 * hugs ordinary formats and keeps extreme ones within the row rhythm.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { fieldRatio } from '../lib/field';

interface Props { src: ImageMetadata; alt: string; sizes: string; eager?: boolean; class?: string }
const { src, alt, sizes, eager = false, class: cls } = Astro.props;
---
<span class:list={['art', cls]} style={`--r:${fieldRatio(src)}`}>
  <Picture src={src} alt={alt} widths={[360, 560, 800, 1100, 1500, 2000]} sizes={sizes} formats={['avif', 'webp']} loading={eager ? 'eager' : 'lazy'} decoding="async" />
</span>
