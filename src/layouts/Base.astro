---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import type { ImageMetadata } from 'astro';
import { SITE } from '../data/site';
import { t, type Lang } from '../i18n/ui';
import { url } from '../lib/url';
import { DEFAULT_PALETTE } from '../lib/palette';
import defaultOg from '../content/works/angel/angel-hero.jpg';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  lang?: Lang;
  current?: 'works' | 'about' | 'contact' | 'home';
  jsonLd?: Record<string, unknown>;
  /** colours the ambient field takes on this page (from a work); neutral otherwise */
  palette?: string[];
  /** quieter field for pages meant for reading and browsing */
  quiet?: boolean;
}

const { title, description = SITE.description, image = defaultOg, imageAlt = 'ANGEL by Daniel Hajduk', lang = 'en', current = 'home', jsonLd, palette = DEFAULT_PALETTE, quiet = false } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: image, width: 1200, format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site);

const nav = [
  { key: 'works', href: url('/works/'), label: t('nav.works', lang) },
  { key: 'about', href: url('/about/'), label: t('nav.about', lang) },
  { key: 'contact', href: url('/contact/'), label: t('nav.contact', lang) },
] as const;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  jobTitle: SITE.role,
  url: new URL(url('/'), Astro.site).href,
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta name="theme-color" content="#000000" />
    <ClientRouter />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogUrl.href} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={lang === 'cs' ? 'cs_CZ' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd ?? personLd)} />
  </head>
  <body data-palette={JSON.stringify(palette)} data-quiet={quiet ? '' : undefined}>
    <canvas class="field" data-field aria-hidden="true" transition:persist="field"></canvas>
    <a class="skip-link" href="#main">{t('nav.skip', lang)}</a>
    <header class="site-header">
      <a class="site-mark" href={url('/')} aria-label={`${SITE.name}, home`}>{SITE.name}</a>
      <nav class="site-nav" aria-label="Main">
        <ul>
          {nav.map((n) => (
            <li><a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} {SITE.name}. {t('footer.rights', lang)}.</p>
      <p>
        {SITE.email && <a href={`mailto:${SITE.email}`}>{SITE.email}</a>}
        {SITE.social.map((s) => <> <a href={s.url} rel="me noopener">{s.label}</a></>)}
        {!SITE.email && SITE.social.length === 0 && <span>{SITE.location}</span>}
      </p>
    </footer>

    <script>
      /*
       * The afterimage field.
       * A slow, blurred body of colour behind every page, drawn on a tiny canvas.
       * Its colours come from the works: whichever [data-palette] dominates the
       * viewport becomes the target, and the field drifts towards it. When the work
       * leaves, its colour stays and fades only as the next one arrives.
       * The field is seen through a soft lens that trails the pointer
       * (on touch screens the lens wanders on its own and follows the finger).
       */
      type RGB = [number, number, number];
      const hexToRgb = (h: string): RGB => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16)) as RGB;

      const state = {
        current: [] as RGB[],
        target: [] as RGB[],
        lens: { x: 0.6, y: 0.4, tx: 0.6, ty: 0.4 },
        touch: !window.matchMedia('(pointer: fine)').matches,
        still: window.matchMedia('(prefers-reduced-motion: reduce)').matches,
        lastInput: 0,
        boost: 0,
        boostTarget: 0,
        io: null as IntersectionObserver | null,
      };

      function setTarget(pal: string[]) {
        const rgb = pal.slice(0, 5).map(hexToRgb);
        while (rgb.length < 5) rgb.push(rgb[rgb.length % Math.max(1, rgb.length)] ?? [40, 36, 32]);
        state.target = rgb;
        if (!state.current.length || state.still) state.current = rgb.map((c) => [...c] as RGB);
      }
      (window as any).__fieldPalette = setTarget;
      (window as any).__fieldBoost = (v: number) => { state.boostTarget = v; };

      function scanPalettes() {
        const body = document.body;
        try { setTarget(JSON.parse(body.dataset.palette || '[]')); } catch {}
        body.classList.toggle('is-quiet', body.hasAttribute('data-quiet'));
        state.io?.disconnect();
        const ratios = new Map<Element, number>();
        state.io = new IntersectionObserver((entries) => {
          entries.forEach((e) => ratios.set(e.target, e.intersectionRatio));
          let best: Element | null = null, max = 0.25;
          ratios.forEach((r, el) => { if (r > max) { max = r; best = el; } });
          if (best) { try { setTarget(JSON.parse((best as HTMLElement).dataset.palette!)); } catch {} }
        }, { threshold: [0, 0.25, 0.5, 0.75, 1] });
        document.querySelectorAll<HTMLElement>('main [data-palette]').forEach((el) => state.io!.observe(el));
      }

      function startField() {
        const canvas = document.querySelector<HTMLCanvasElement>('[data-field]');
        if (!canvas || (canvas as any).__running) return;
        (canvas as any).__running = true;
        const ctx = canvas.getContext('2d', { alpha: false })!;
        const blobs = Array.from({ length: 7 }, (_, i) => ({
          bx: 0.15 + ((i * 0.37) % 0.7), by: 0.15 + ((i * 0.53) % 0.7),
          ax: 0.18 + (i % 3) * 0.06, ay: 0.14 + (i % 2) * 0.08,
          sp: 0.00005 + i * 0.000013, ph: i * 1.7, r: 0.38 + (i % 4) * 0.08, ci: i % 5,
        }));
        const resize = () => {
          const k = 0.09;
          canvas.width = Math.max(48, Math.round(innerWidth * k));
          canvas.height = Math.max(48, Math.round(innerHeight * k));
        };
        resize();
        addEventListener('resize', resize);
        addEventListener('pointermove', (e) => {
          if (e.pointerType === 'mouse' || e.pointerType === 'pen') state.touch = false;
          state.lens.tx = e.clientX / innerWidth;
          state.lens.ty = e.clientY / innerHeight;
          state.lastInput = performance.now();
        }, { passive: true });

        const draw = (t: number) => {
          const w = canvas.width, h = canvas.height, m = Math.max(w, h);
          // colours drift slowly: this lag is the afterimage
          state.current = state.current.map((c, i) => c.map((v, j) => v + (state.target[i][j] - v) * 0.012) as RGB);
          ctx.globalCompositeOperation = 'source-over';
          ctx.fillStyle = '#000';
          ctx.fillRect(0, 0, w, h);
          ctx.globalCompositeOperation = 'lighter';
          for (const b of blobs) {
            const x = (b.bx + Math.sin(t * b.sp + b.ph) * b.ax) * w;
            const y = (b.by + Math.cos(t * b.sp * 1.3 + b.ph) * b.ay) * h;
            const r = b.r * m;
            const [cr, cg, cb] = state.current[b.ci];
            const g = ctx.createRadialGradient(x, y, 0, x, y, r);
            g.addColorStop(0, `rgba(${cr | 0},${cg | 0},${cb | 0},0.5)`);
            g.addColorStop(1, `rgba(${cr | 0},${cg | 0},${cb | 0},0)`);
            ctx.fillStyle = g;
            ctx.fillRect(0, 0, w, h);
          }
          // lens: trails the pointer; wanders by itself on touch or when idle
          const idle = state.touch || t - state.lastInput > 6000;
          if (idle) {
            state.lens.tx = 0.5 + Math.sin(t * 0.00011) * 0.32;
            state.lens.ty = 0.45 + Math.sin(t * 0.00017 + 1) * 0.3;
          }
          const ease = idle ? 0.01 : 0.045;
          state.lens.x += (state.lens.tx - state.lens.x) * ease;
          state.lens.y += (state.lens.ty - state.lens.y) * ease;
          state.boost += (state.boostTarget - state.boost) * 0.06;
          canvas.style.setProperty('--lx', `${(state.lens.x * 100).toFixed(2)}%`);
          canvas.style.setProperty('--ly', `${(state.lens.y * 100).toFixed(2)}%`);
          canvas.style.setProperty('--boost', state.boost.toFixed(3));
        };

        if (state.still) {
          draw(0);
          return;
        }
        const loop = (t: number) => {
          if (!document.hidden) draw(t);
          requestAnimationFrame(loop);
        };
        requestAnimationFrame(loop);
      }

      /* Scroll-linked motion: depth parallax, scattering letters, emerging works. */
      function initMotion() {
        const root = document.documentElement;
        if (state.still) { root.classList.remove('motion'); return; }
        root.classList.add('motion');
        const depth = Array.from(document.querySelectorAll<HTMLElement>('[data-depth]'));
        const scatter = Array.from(document.querySelectorAll<HTMLElement>('[data-scatter]'));
        const progress = Array.from(document.querySelectorAll<HTMLElement>('[data-progress]'));
        const reveals = document.querySelectorAll<HTMLElement>('[data-reveal]');
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -8% 0px' });
        reveals.forEach((el) => io.observe(el));

        let ticking = false;
        const update = () => {
          const vh = innerHeight;
          for (const el of depth) {
            const r = el.getBoundingClientRect();
            if (r.bottom < -vh || r.top > vh * 2) continue;
            const k = parseFloat(el.dataset.depth || '0');
            el.style.setProperty('--dy', `${((r.top + r.height / 2 - vh / 2) * -k).toFixed(1)}px`);
          }
          for (const el of scatter) {
            const s = Math.min(1, Math.max(0, scrollY / (vh * 0.9)));
            el.style.setProperty('--s', s.toFixed(3));
          }
          for (const el of progress) {
            const r = el.getBoundingClientRect();
            const p = Math.min(1, Math.max(0, (vh - r.top) / (r.height + vh * 0.2)));
            el.style.setProperty('--p', p.toFixed(3));
          }
          ticking = false;
        };
        const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
        addEventListener('scroll', onScroll, { passive: true });
        addEventListener('resize', onScroll);
        document.addEventListener('astro:before-swap', () => {
          removeEventListener('scroll', onScroll);
          removeEventListener('resize', onScroll);
          io.disconnect();
        }, { once: true });
        update();
      }

      document.addEventListener('astro:page-load', () => {
        scanPalettes();
        startField();
        initMotion();
        (window as any).__fieldBoost(0);
      });
    </script>
  </body>
</html>
