---
import Base from '../layouts/Base.astro';
import Wall from '../components/Wall.astro';
import { getWorks, getSelectedWorks } from '../lib/works';

// The wall shows the selected works; if none are marked, every work.
const chosen = await getSelectedWorks();
const works = chosen.length ? chosen : await getWorks();
---
<Base current="home">
  <Wall works={works} />
</Base>
