---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Exhibit from '../components/Exhibit.astro';
import EmptyWall from '../components/EmptyWall.astro';
import { SITE, CATEGORIES, roomNumber } from '../data/site';
import { getWorks, getSelectedWorks } from '../lib/works';
import { url } from '../lib/url';

const works = await getWorks();
const selected = await getSelectedWorks();
const featured = selected[0] ?? works[0];
const counts = Object.fromEntries(CATEGORIES.map((c) => [c.id, works.filter((w) => w.data.category === c.id).length]));
const empty = CATEGORIES.filter((c) => !counts[c.id]).map((c) => c.id);
const [first, last] = SITE.name.toUpperCase().split(' ');
// Disciplines for the moving band, written as the artist names them.
const band = ['Painting', 'Sculpture', 'Photography', 'Other works'];
---
<Base current="home">
  <section class="hero" aria-labelledby="hero-title" data-spot>
    <h1 class="visually-hidden" id="hero-title">{SITE.name}, artist</h1>
    <p class="hero-name fill" aria-hidden="true"><span class="n1">{first}</span><span class="n2">{last}</span></p>

    {featured && (
      <figure class="hero-figure">
        <div data-parallax="-0.06">
          <Picture src={featured.data.cover} alt={featured.data.coverAlt} widths={[520, 820, 1200]} sizes="(max-width: 60rem) 78vw, 36vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" />
        </div>
      </figure>
    )}

    <p class="hero-name outline" aria-hidden="true"><span class="n1">{first}</span><span class="n2">{last}</span></p>

    <div class="hero-foot">
      <p class="hero-role">Painting, sculpture and other visual work.<br />Studio in {SITE.location}.</p>
      <nav class="plan" aria-label="Exhibition rooms">
        <p class="plan-title">Rooms</p>
        <ol>
          {CATEGORIES.map((c) => (
            <li>
              <a href={url(`/works/${c.id}/`)}>
                <span class="numeral">{roomNumber(c.id)}</span>
                <span class="plan-name">{c.label}</span>
                <span class="plan-count">{counts[c.id] === 1 ? '1 work' : counts[c.id] ? `${counts[c.id]} works` : 'In preparation'}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </div>
  </section>

  <div class="band" aria-hidden="true">
    <p class="band-row" data-drift="-0.35">{[...band, ...band, ...band].map((w, i) => <span class:list={{ o: i % 2 === 1 }}>{w}</span>)}</p>
    <p class="band-row" data-drift="0.25">{[...band, ...band, ...band].reverse().map((w, i) => <span class:list={{ o: i % 2 === 0 }}>{w}</span>)}</p>
  </div>

  {selected.map((w, i) => <Exhibit work={w} flip={i % 2 === 1} lead={w.id === featured?.id ? 1 : undefined} />)}

  {empty.length > 0 && <EmptyWall ids={empty} />}

  <section class="statement" aria-labelledby="statement-title" data-spot>
    <p class="monogram" aria-hidden="true">DH</p>
    <h2 class="visually-hidden" id="statement-title">About the artist</h2>
    <blockquote>
      <p>Daniel Hajduk works across painting, sculpture and other visual techniques. His paintings have found collectors at home and abroad.</p>
    </blockquote>
    <a class="statement-link" href={url('/about/')}>About the artist</a>
  </section>

  <section class="enquiries" aria-labelledby="enquiries-title">
    <h2 id="enquiries-title"><a href={url('/contact/')} class="enquiries-word">Enquiries</a></h2>
    <p>Works, commissions and collaborations. Available works and prices are listed on the contact page.</p>
  </section>
</Base>
