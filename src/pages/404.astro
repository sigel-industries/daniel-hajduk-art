---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---
<Base title="Page not found">
  <header class="page-head" data-spot>
    <p class="page-room">Error 404</p>
    <h1 class="display" style="--chars:9">Not found</h1>
    <div class="page-head-foot">
      <p>This page does not exist or has moved. <a href={url('/works/')}>Walk through the works</a> or return to the <a href={url('/')}>entrance</a>.</p>
    </div>
  </header>
</Base>
