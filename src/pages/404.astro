---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---
<Base title="Page not found">
  <section class="page contact">
    <p class="page-kicker">404</p>
    <h1 class="page-word">Page not found</h1>
    <div class="page-cols">
      <p class="page-lede">This page does not exist or has moved. Go to the <a href={url('/')}>home page</a> or see <a href={url('/works/')}>all works</a>.</p>
    </div>
  </section>
</Base>
