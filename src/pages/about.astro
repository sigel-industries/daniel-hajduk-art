---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
import { url } from '../lib/url';

/*
 * Only confirmed facts are written as text.
 * Items marked with class="todo" are placeholders awaiting the artist's confirmation;
 * replace them with real content (or delete them) before publishing.
 */
---
<Base title="About" current="about" description="About Daniel Hajduk, an artist working in painting, sculpture and other visual media.">
  <header class="wrap page-head">
    <h1 style="--chars:5">About</h1>
  </header>
  <section class="wrap" style="padding-bottom:clamp(4rem,8vw,7rem)">
    <div class="split">
      <div class="side">
        <dl class="facts">
          <dt>Name</dt><dd>{SITE.name}</dd>
          <dt>Disciplines</dt><dd>Painting, sculpture, other visual techniques</dd>
          <dt>Based in</dt><dd>{SITE.location}</dd>
        </dl>
      </div>
      <div class="main prose">
        <p class="lede" style="margin-bottom:1.5rem">Daniel Hajduk is an artist working across painting, sculpture and other visual techniques.</p>
        <p>Painting is the largest part of his work. Over the years his paintings have been acquired by collectors, including buyers abroad. Alongside painting he develops sculptural work, such as the limited edition <a href={url('/works/sculptures/angel/')}>ANGEL</a>.</p>
        {import.meta.env.DEV && <p><span class="todo">To confirm: a few sentences in the artist's own words about his approach, themes and materials.</span></p>}
        {import.meta.env.DEV && <p><span class="todo">To confirm: education, exhibitions, collections or other biographical facts the artist wants to publish.</span></p>}
      </div>
    </div>
  </section>
</Base>
