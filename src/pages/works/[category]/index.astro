---
import Base from '../../../layouts/Base.astro';
import WorksIndex from '../../../components/WorksIndex.astro';
import { CATEGORIES } from '../../../data/site';
import { getWorks } from '../../../lib/works';

// Only disciplines that contain works get a page.
export async function getStaticPaths() {
  const works = await getWorks();
  return CATEGORIES.filter((c) => works.some((w) => w.data.category === c.id)).map((c) => ({ params: { category: c.id }, props: { category: c } }));
}

const { category } = Astro.props;
const all = await getWorks();
const works = all.filter((w) => w.data.category === category.id);
---
<Base title={category.label} current="works" quiet description={`${category.label} by Daniel Hajduk. ${category.intro}`}>
  <WorksIndex works={works} all={all} active={category.id} />
</Base>
