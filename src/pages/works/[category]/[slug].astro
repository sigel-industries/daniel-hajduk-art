---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Gallery from '../../../components/Gallery.astro';
import { SITE, AVAILABILITY_LABEL } from '../../../data/site';
import { categoryOf, groupOf } from '../../../lib/taxonomy';
import Mount from '../../../components/Mount.astro';
import { getWorks, type Work } from '../../../lib/works';
import { sequence } from '../../../lib/curation';
import { url, workUrl, formatPrice } from '../../../lib/url';
import { t } from '../../../i18n/ui';

export async function getStaticPaths() {
  const works = await getWorks();
  return works.map((work) => ({ params: { category: work.data.category, slug: work.id }, props: { work } }));
}

const { work } = Astro.props as { work: Work };
const all = await getWorks();
const at = all.findIndex((w) => w.id === work.id);
const next = all.length > 1 ? all[(at + 1) % all.length] : null;
const prev = all.length > 1 ? all[(at - 1 + all.length) % all.length] : null;
// related: same series first, then same discipline, in the curated sequence
const pool = all.filter((w) => w.id !== work.id);
const same = (w: Work) => (work.data.group && w.data.group === work.data.group) || (work.data.series && w.data.series === work.data.series);
const related = (await sequence([...pool.filter(same), ...pool.filter((w) => !same(w) && w.data.category === work.data.category)])).slice(0, 4);
const d = work.data;
const { Content } = await render(work);
const category = await categoryOf(work);
const group = await groupOf(work);
const images = d.images.length ? d.images : [{ src: d.cover, alt: d.coverAlt }];
const description = d.summary ?? `${d.title}, ${category.label.toLowerCase()} by ${SITE.name}.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VisualArtwork',
  name: d.title,
  creator: { '@type': 'Person', name: SITE.name },
  artform: category.label,
  ...(d.materials && { artMedium: d.materials }),
  ...(d.year && { dateCreated: String(d.year) }),
  ...(d.edition && { artEdition: d.edition.size }),
  ...(d.price && d.availability === 'available' && {
    offers: { '@type': 'Offer', price: d.price.amount, priceCurrency: d.price.currency, availability: 'https://schema.org/InStock', ...(d.links[0] && { url: d.links[0].url }) },
  }),
};
---
<Base title={d.title} description={description} image={d.cover} imageAlt={d.coverAlt} current="works" jsonLd={jsonLd}>
  <article class="work" aria-labelledby="work-title">
    <Gallery images={images} details={d.details} title={d.title}>
      <div class="work-caption" slot="caption">
        <p class="wc-artist">{SITE.name}</p>
        <h1 class="wc-title" id="work-title">{d.title}</h1>
        <dl class="facts">
          <div><dt>Category</dt><dd><a href={url(`/works/${category.id}/`)}>{category.singular}</a></dd></div>
          {group && <div><dt>Body of work</dt><dd><a href={url(`/works/?g=${group.id}`)}>{group.title}</a></dd></div>}
          {d.year && <div><dt>{t('work.year')}</dt><dd>{d.year}</dd></div>}
          {d.technique && <div><dt>{t('work.technique')}</dt><dd>{d.technique}</dd></div>}
          {d.materials && <div><dt>{t('work.materials')}</dt><dd>{d.materials}</dd></div>}
          {d.dimensions && <div><dt>{t('work.dimensions')}</dt><dd>{d.dimensions}</dd></div>}
          {d.edition && <div><dt>{t('work.edition')}</dt><dd>{d.edition.size} numbered and signed copies</dd></div>}
          {d.availability && <div><dt>{t('work.status')}</dt><dd><span class="status" data-state={d.availability}>{AVAILABILITY_LABEL[d.availability]}{d.availability === 'available' && d.edition && d.edition.available.length > 0 && `, copies ${d.edition.available.join(' and ')}`}</span></dd></div>}
        </dl>
        {d.price && d.availability === 'available' && <p class="wc-price">{formatPrice(d.price.amount, d.price.currency)}{d.price.note && <span> {d.price.note}</span>}</p>}
        <div class="wc-actions">
          {d.links.map((l) => <a class="btn" href={l.url} rel="noopener" target="_blank">{l.label}<span class="visually-hidden"> (opens in a new tab)</span></a>)}
          <a class="btn ghost" href={SITE.email ? `mailto:${SITE.email}?subject=${encodeURIComponent(d.title)}` : url('/contact/')}>{t('work.enquire')}</a>
        </div>
      </div>
    </Gallery>

    {(d.summary || work.body?.trim()) && (
      <div class="work-text">
        {d.summary && <p class="work-lede">{d.summary}</p>}
        <div class="prose"><Content /></div>
      </div>
    )}

    {related.length > 0 && (
      <section class="related" aria-labelledby="related-title">
        <h2 id="related-title">{group ? `More from ${group.title}` : `More ${category.label.toLowerCase()}`}</h2>
        <ul class="plates">
          {related.map((w) => (
            <li class="plate">
              <a href={workUrl(w.data.category, w.id)}>
                <Mount src={w.data.cover} alt={w.data.coverAlt} sizes="(max-width: 40rem) 46vw, 22vw" />
                <span class="plate-cap"><span class="plate-title">{w.data.title}</span></span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {next && prev && (
      <nav class="work-nav" aria-label="More works">
        <a href={workUrl(prev.data.category, prev.id)}><span>Previous</span>{prev.data.title}</a>
        <a href={url('/works/')} class="work-nav-all">Archive</a>
        <a href={workUrl(next.data.category, next.id)}><span>Next</span>{next.data.title}</a>
      </nav>
    )}
  </article>
</Base>
