---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Gallery from '../../../components/Gallery.astro';
import { AVAILABILITY_LABEL, CATEGORIES, SITE } from '../../../data/site';
import { getWorks, type Work } from '../../../lib/works';
import { url, formatPrice } from '../../../lib/url';
import { t } from '../../../i18n/ui';

export async function getStaticPaths() {
  const works = await getWorks();
  return works.map((work) => ({ params: { category: work.data.category, slug: work.id }, props: { work } }));
}

const { work } = Astro.props as { work: Work };
const d = work.data;
const { Content } = await render(work);
const category = CATEGORIES.find((c) => c.id === d.category)!;
const images = d.images.length ? d.images : [{ src: d.cover, alt: d.coverAlt }];
const description = d.summary ?? `${d.title}, ${category.label.toLowerCase()} by ${SITE.name}.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VisualArtwork',
  name: d.title,
  creator: { '@type': 'Person', name: SITE.name },
  artform: category.label,
  ...(d.materials && { artMedium: d.materials }),
  ...(d.year && { dateCreated: String(d.year) }),
  ...(d.edition && { artEdition: d.edition.size }),
  ...(d.price && d.availability === 'available' && {
    offers: { '@type': 'Offer', price: d.price.amount, priceCurrency: d.price.currency, availability: 'https://schema.org/InStock', ...(d.links[0] && { url: d.links[0].url }) },
  }),
};
---
<Base title={d.title} description={description} image={d.cover} imageAlt={d.coverAlt} current="works" jsonLd={jsonLd}>
  <article class="wrap work">
    <Gallery images={images} title={d.title} />

    <aside class="work-info" aria-labelledby="work-title">
      <h1 id="work-title">{d.title}</h1>
      {d.summary && <p class="summary">{d.summary}</p>}
      <dl class="facts">
        <dt>Category</dt><dd><a href={url(`/works/${category.id}/`)}>{category.label}</a></dd>
        {d.year && <><dt>{t('work.year')}</dt><dd>{d.year}</dd></>}
        {d.technique && <><dt>{t('work.technique')}</dt><dd>{d.technique}</dd></>}
        {d.materials && <><dt>{t('work.materials')}</dt><dd>{d.materials}</dd></>}
        {d.dimensions && <><dt>{t('work.dimensions')}</dt><dd>{d.dimensions}</dd></>}
        {d.edition && <><dt>{t('work.edition')}</dt><dd>{t('work.editionOf')} {d.edition.size}</dd></>}
        {d.edition && d.edition.available.length > 0 && d.availability === 'available' && <><dt>{t('work.availableCopies')}</dt><dd>{d.edition.available.join(', ')}</dd></>}
        <dt>{t('work.status')}</dt><dd><span class="status" data-state={d.availability}>{AVAILABILITY_LABEL[d.availability]}</span></dd>
      </dl>
      {d.price && d.availability === 'available' && (
        <p class="price">{formatPrice(d.price.amount, d.price.currency)} {d.price.note && <small>{d.price.note}</small>}</p>
      )}
      <div class="actions">
        {d.links.map((l, i) => <a class={i === 0 ? 'button' : 'button secondary'} href={l.url} rel="noopener" target="_blank">{l.label}<span class="visually-hidden"> (opens in a new tab)</span></a>)}
        {SITE.email && <a class="button secondary" href={`mailto:${SITE.email}?subject=${encodeURIComponent(d.title)}`}>{t('work.enquire')}</a>}
      </div>
      <a class="back" href={url(`/works/${category.id}/`)}>{t('work.back')} {category.label.toLowerCase()}</a>
    </aside>

    <div class="work-text prose">
      <Content />
    </div>
  </article>
</Base>
