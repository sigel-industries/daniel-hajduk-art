---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Gallery from '../../../components/Gallery.astro';
import WorkLabel from '../../../components/WorkLabel.astro';
import { CATEGORIES, SITE, roomNumber } from '../../../data/site';
import { getWorks, type Work } from '../../../lib/works';
import { url } from '../../../lib/url';
import { t } from '../../../i18n/ui';

export async function getStaticPaths() {
  const works = await getWorks();
  return works.map((work) => ({ params: { category: work.data.category, slug: work.id }, props: { work } }));
}

const { work } = Astro.props as { work: Work };
const d = work.data;
const { Content } = await render(work);
const category = CATEGORIES.find((c) => c.id === d.category)!;
const images = d.images.length ? d.images : [{ src: d.cover, alt: d.coverAlt }];
const description = d.summary ?? `${d.title}, ${category.label.toLowerCase()} by ${SITE.name}.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VisualArtwork',
  name: d.title,
  creator: { '@type': 'Person', name: SITE.name },
  artform: category.label,
  ...(d.materials && { artMedium: d.materials }),
  ...(d.year && { dateCreated: String(d.year) }),
  ...(d.edition && { artEdition: d.edition.size }),
  ...(d.price && d.availability === 'available' && {
    offers: { '@type': 'Offer', price: d.price.amount, priceCurrency: d.price.currency, availability: 'https://schema.org/InStock', ...(d.links[0] && { url: d.links[0].url }) },
  }),
};
---
<Base title={d.title} description={description} image={d.cover} imageAlt={d.coverAlt} current="works" jsonLd={jsonLd}>
  <article class="work" aria-labelledby="work-title" style={`--chars:${d.title.length}`}>
    <header class="work-head" data-spot>
      <p class="page-room"><a href={url(`/works/${category.id}/`)}><span class="numeral">{roomNumber(category.id)}</span>{category.label}</a></p>
      <p class="work-word" aria-hidden="true"><span class="fill">{d.title}</span><span class="outline">{d.title}</span></p>
    </header>

    <Gallery images={images} title={d.title}>
      <div class="work-label" slot="label">
        <WorkLabel work={work} headingLevel="h1" headingId="work-title" mode="detail" />
      </div>
    </Gallery>

    <div class="work-text">
      {d.summary && <p class="work-lede">{d.summary}</p>}
      <div class="prose"><Content /></div>
      <a class="back" href={url(`/works/${category.id}/`)}>{t('work.back')} {category.label.toLowerCase()}</a>
    </div>
  </article>
</Base>
