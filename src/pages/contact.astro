---
import Base from '../layouts/Base.astro';
import { SITE, AVAILABILITY_LABEL } from '../data/site';
import { getWorks } from '../lib/works';
import { workUrl, formatPrice } from '../lib/url';

const available = (await getWorks()).filter((w) => w.data.availability === 'available' || w.data.availability === 'on-request');
---
<Base title="Contact" current="contact" description="Contact Daniel Hajduk and see works currently available for acquisition.">
  <section class="contact">
    <h1 class="contact-word">Enquiries</h1>
    <div class="contact-body">
      <p class="contact-lede">For works, commissions, exhibitions and collaborations.</p>
      <dl class="contact-facts">
        <div><dt>Studio</dt><dd>{SITE.location}</dd></div>
        {SITE.email
          ? <div><dt>E-mail</dt><dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
          : import.meta.env.DEV && <div><dt>E-mail</dt><dd><span class="todo">To confirm: public e-mail address</span></dd></div>}
        {SITE.social.map((s) => <div><dt>{s.label}</dt><dd><a href={s.url} rel="me noopener">{s.url.replace(/^https?:\/\//, '')}</a></dd></div>)}
      </dl>
    </div>

    {available.length > 0 && (
      <div class="available">
        <h2>Available works</h2>
        <ul>
          {available.map((w) => {
            const d = w.data;
            return (
              <li>
                <a href={workUrl(d.category, w.id)}>
                  <span class="available-title">{d.title}</span>
                  <span class="available-meta">{[d.materials ?? d.technique, d.dimensions, d.edition && d.edition.available.length ? `copies ${d.edition.available.join(', ')}` : null].filter(Boolean).join(', ')}</span>
                  <span class="available-price">{d.price ? formatPrice(d.price.amount, d.price.currency) : AVAILABILITY_LABEL[d.availability]}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    )}
  </section>
</Base>
