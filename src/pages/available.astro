---
import Base from '../layouts/Base.astro';
import WorksIndex from '../components/WorksIndex.astro';
import { getWorks } from '../lib/works';

const works = await getWorks();
---
<Base title="Available works" current="available" description="Works by Daniel Hajduk available for acquisition.">
  <WorksIndex works={works} title="Available" intro="Works that can be acquired now. For anything else, please get in touch." preset={{ s: 'available' }} />
</Base>
