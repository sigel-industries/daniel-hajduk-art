---
import Base from '../layouts/Base.astro';
import WorksIndex from '../components/WorksIndex.astro';
import { getWorks } from '../lib/works';

const all = await getWorks();
const works = all.filter((w) => w.data.availability === 'available' || w.data.availability === 'on-request');
---
<Base title="Available works" current="works" description="Works by Daniel Hajduk available for acquisition.">
  <WorksIndex works={works} all={all} title="Available" intro="Works that can be acquired now. For other works, please get in touch." />
</Base>
